{
  "schema_version": "v1",
  "dataset_name": "parameter",
  "description": "参数正确率评估数据集：评估单个工具调用中的关键参数是否能根据用户指令、初始状态和工具说明准确填写",
  "samples": [
    {
      "id": "param_connect_001",
      "metric": "parameter",
      "user_instruction": "按当前连接画像连接右臂。",
      "initial_state": {
        "arm_profile": {
          "arm_model": 65,
          "right_ip": "192.168.1.18",
          "left_ip": "192.168.1.19",
          "description": "双臂默认连接画像"
        }
      },
      "expected_output": {
        "calls": [
          {
            "tool": "Connect_Arms",
            "args": {
              "right_ip": "192.168.1.18",
              "arm_model": 65
            },
            "key_args": [
              "right_ip",
              "arm_model"
            ]
          }
        ]
      },
      "scoring_mode": "tool_and_args",
      "tags": [
        "arm",
        "connect",
        "right_ip",
        "arm_model"
      ],
      "notes": "评估从 arm_profile 中提取右臂 IP 和型号参数"
    },
    {
